# Cache des fichiers servis par Cloudflare.
# Une règle par type, sans chevauchement : si deux règles donnaient chacune un
# Cache-Control, Cloudflare les accolerait en une seule valeur incohérente.

# Musiques et images : cache d'un an. Un fichier qui change doit changer de nom
# (sinon les joueurs déjà venus gardent l'ancien).
/*.mp3
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable

# La page, et sprites.js qui garde le même nom à chaque mise à jour :
# le navigateur redemande à chaque visite et reçoit un 304 s'il n'a pas changé.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/nocturne
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate
